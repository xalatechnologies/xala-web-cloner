# Copy to .env.local and fill in. .env.local is gitignored (.gitignore:17).
#
# Only VITE_-prefixed variables reach the browser bundle. Every key below is
# read by Node scripts only and must NOT be given a VITE_ prefix — a SERP or
# Search Console key in the client bundle is a key anyone can read with
# view-source and spend on your account.

# ── Browser (public by design) ───────────────────────────────────────────────
VITE_RECAPTCHA_SITE_KEY=

# Where the contact and job-application forms POST. Leave EMPTY: it defaults to
# the same-origin /api/contact, which is the endpoint in server/contact-endpoint.mjs
# running on the VPS (systemd unit xala-contact, installed by
# deploy/install-contact-endpoint.sh). Same origin means no CORS and no key in
# the bundle.
#
# Set it to a full URL to point somewhere else, or to the literal "off" to
# restore the old mailto behaviour. "off" also switches Google Ads conversions
# off in practice: a mailto is not a confirmed send, so trackConversion()
# reports it to GA4 and never to Ads.
VITE_FORM_ENDPOINT=

# Google Ads conversion labels. The account tag itself (AW-18385967405) is a
# committed constant in src/lib/analytics/ids.ts; these are the per-action
# labels, which do not exist until someone creates the conversion actions in
# Google Ads. Copy the label — the part after the slash in "AW-…/AbC-dEf123" —
# and paste it here.
#
# Leave them empty and nothing breaks: the GA4 event still fires, so the funnel
# is measurable, and the Ads conversion is simply not sent.
VITE_ADS_LABEL_CONTACT=
VITE_ADS_LABEL_APPLICATION=

# ── SEO tooling (server-side only, never bundled) ────────────────────────────

# DataForSEO — rank tracking. dashboard → API Access.
# The password is the API password shown there, not your dashboard password.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# SerpAPI — alternative SERP source. serpapi.com/manage-api-key
SERPAPI_KEY=

# Google Search Console — indexing truth and real query data.
#   1. console.cloud.google.com → new project
#   2. Enable "Google Search Console API"
#   3. IAM → Service Accounts → create → Keys → add JSON key
#   4. From the JSON: client_email and private_key
#   5. search.google.com/search-console → Settings → Users and permissions →
#      add the client_email as a Full user
# GSC_SITE_URL must match the property exactly:
#   domain property → sc-domain:xala.no
#   URL prefix      → https://xala.no/
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_SITE_URL=sc-domain:xala.no

# PageSpeed Insights — Core Web Vitals from real Chrome users.
# console.cloud.google.com → enable "PageSpeed Insights API" → Credentials →
# API key. Free, no billing account required.
PAGESPEED_API_KEY=
